{
  "expo": {
    "name": "New Malik Veterinary",
    "slug": "Vet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vetapp",
    "icon": "./assets/logo_final_correct.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_final_correct.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vetstore.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo_final_correct.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo_final_correct.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ]
  }
}